# Environment variables for Scrum AI Assistant

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/scrum_db

# Redis
REDIS_URL=redis://redis:6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND_URL=redis://redis:6379/1

# FastAPI
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Jira Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=your-api-token-here
JIRA_USER_EMAIL=your-email@example.com

# Azure Boards Configuration
AZURE_BOARDS_ORG=your-org-name
AZURE_BOARDS_PAT=your-personal-access-token

# Slack Notification
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Logging
LOG_LEVEL=INFO

# Application
APP_NAME=Scrum AI Assistant
APP_VERSION=1.0.0
